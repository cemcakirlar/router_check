{
  "productName": "Router Check (Tauri)",
  "version": "1.0.0",
  "identifier": "com.router.check",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": null,
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Router Check (Tauri)",
