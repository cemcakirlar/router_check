{
  "name": "router-check",
  "productName": "Router Check (Electron)",
  "version": "1.0.0",
  "description": "ZTE Router Dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.router.check",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      "index.html",
      "dashboard.js"
    ],
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ]
  }
}
